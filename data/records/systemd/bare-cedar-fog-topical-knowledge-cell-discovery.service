WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/topical-knowledge-cell-discovery-service
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Environment=HOST=127.0.0.1
Environment=PORT=19839
Environment=BASE_URL=http://127.0.0.1:19839
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/topical-knowledge-cell-discovery-service/data/credentials/agent-card.pkcs8.pem
